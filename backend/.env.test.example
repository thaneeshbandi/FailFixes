# Copy to .env.test. Committed as documentation — contains no real values.
#
# The test suite issues deleteMany() against this database.
# tests/setup/guardTestDatabase.js refuses to run unless:
#   - NODE_ENV=test
#   - the host is local (localhost / 127.0.0.1 / a CI service container)
#   - the database name contains "test"
NODE_ENV=test
MONGODB_URI=mongodb://127.0.0.1:27017/failfixes_test

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRE=2d
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
