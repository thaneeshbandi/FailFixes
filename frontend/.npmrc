# Enforce the `engines` block in package.json instead of only warning.
#
# Why: npm 11 and npm 10.9 resolve this project's optional peer dependencies
# differently. npm 11 omits the nested `type-fest@4.41.0` and `yaml@2.9.0`
# entries that npm 10.9 requires, so a lockfile written by npm 11 makes
# `npm ci` fail in CI with "package.json and package-lock.json are not in sync".
#
# Every environment that installs this package must therefore be on Node 22
# (which bundles npm 10.9.x):
#   - local dev      -> .nvmrc
#   - GitHub Actions -> NODE_VERSION in .github/workflows/ci-cd.yml
#   - Vercel         -> engines.node in package.json (Vercel honours 22.x;
#                       its default is 24.x, which ships npm 11)
#
# engine-strict turns the engines block into a hard failure rather than a
# warning, so a mismatched toolchain is caught before it can rewrite the lock.
engine-strict=true
